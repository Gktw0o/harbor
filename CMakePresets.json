{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "description": "MSVC + Ninja. Needs a VS developer environment for the target arch (scripts/build.ps1 sets one up).",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "inherits": "msvc-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "HARBOR_TARGET_ARCH": "x64"
      }
    },
    {
      "name": "msvc-arm64",
      "displayName": "MSVC ARM64",
      "inherits": "msvc-base",
      "architecture": { "value": "arm64", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "HARBOR_TARGET_ARCH": "ARM64"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x64-debug", "configurePreset": "msvc-x64", "configuration": "Debug" },
    { "name": "msvc-x64-release", "configurePreset": "msvc-x64", "configuration": "Release" },
    { "name": "msvc-arm64-debug", "configurePreset": "msvc-arm64", "configuration": "Debug" },
    { "name": "msvc-arm64-release", "configurePreset": "msvc-arm64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "msvc-x64", "inherits": "test-base", "configurePreset": "msvc-x64" },
    { "name": "msvc-arm64", "inherits": "test-base", "configurePreset": "msvc-arm64" }
  ]
}
