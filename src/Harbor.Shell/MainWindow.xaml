<Window
    x:Class="Harbor.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Harbor Shell">
  <StackPanel Padding="24" Spacing="12">
    <TextBlock x:Name="StatusText" Text="Not connected" Style="{StaticResource BodyTextBlockStyle}" />
    <TextBlock x:Name="TaskbarText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
    <Button x:Name="RestoreButton" Content="Restore taskbar now" Click="OnRestoreClicked" />
  </StackPanel>
</Window>
