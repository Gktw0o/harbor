<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 22H2 -->
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Unpackaged, with the Windows App SDK runtime bundled, until MSIX packaging in M7. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Core\Harbor.Core.csproj" />
    <ProjectReference Include="..\Harbor.Platform\Harbor.Platform.csproj" />
  </ItemGroup>

  <!-- The dock Harbor Shell starts and supervises, from the CMake build of the same architecture and
       configuration (scripts\build.ps1 builds it first). Without it, the Shell waits for a dock started by
       hand. MSIX packaging (M7) replaces this. -->
  <PropertyGroup>
    <HarborDockArch Condition="'$(Platform)' == 'x64'">x64</HarborDockArch>
    <HarborDockArch Condition="'$(Platform)' == 'ARM64'">arm64</HarborDockArch>
    <HarborDockExe>$(MSBuildThisFileDirectory)..\..\build\msvc-$(HarborDockArch)\src\dock\$(Configuration)\harbor-dock.exe</HarborDockExe>
  </PropertyGroup>
  <ItemGroup Condition="'$(HarborDockArch)' != '' And Exists('$(HarborDockExe)')">
    <None Include="$(HarborDockExe)" Link="harbor-dock.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
