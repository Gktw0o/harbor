root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Tests: constant arrays in assertions are clearer than static fields, and they are not hot paths.
[tests/**.cs]
dotnet_diagnostic.CA1861.severity = none
