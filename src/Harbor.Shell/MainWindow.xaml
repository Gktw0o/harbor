<Window
    x:Class="Harbor.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Harbor Shell">
  <StackPanel Padding="24" Spacing="12">
    <TextBlock x:Name="DockText" Text="Starting…" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
    <TextBlock x:Name="StatusText" Text="Not connected" Style="{StaticResource CaptionTextBlockStyle}" />
    <ToggleSwitch x:Name="HideToggle" Header="Hide the Windows taskbar" Toggled="OnHideToggled" />
    <TextBlock Text="Ctrl+Alt+Shift+H brings the taskbar back at any time." TextWrapping="Wrap"
               Style="{StaticResource CaptionTextBlockStyle}" />
    <TextBlock x:Name="TaskbarText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="RestoreButton" Content="Restore taskbar now" Click="OnRestoreClicked" />
      <Button x:Name="StartDockButton" Content="Start dock" Click="OnStartDockClicked" IsEnabled="False" />
      <Button x:Name="StopDockButton" Content="Stop dock" Click="OnStopDockClicked" IsEnabled="False" />
    </StackPanel>
    <TextBlock Text="Pinned apps" Margin="0,12,0,0" Style="{StaticResource SubtitleTextBlockStyle}" />
    <TextBlock x:Name="PinnedText" Text="Looking them up…" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
    <TextBlock x:Name="SettingsProblemText" TextWrapping="Wrap" Visibility="Collapsed"
               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource BodyTextBlockStyle}" />
    <TextBlock x:Name="PinRequestText" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Edit pinned apps…" Click="OnEditPinnedClicked" />
    </StackPanel>
    <TextBlock Text="Pinned apps are kept in settings.json; Harbor picks up your changes when you save it."
               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
  </StackPanel>
</Window>
